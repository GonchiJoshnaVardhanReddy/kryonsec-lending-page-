# Environment files — never commit
.env
.env.*
!.env.example

# Wrangler's local secrets file. It holds the same values the Pages project
# keeps encrypted, so a filled-in copy is a credential in the repository.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Dependencies
node_modules/

# Logs
*.log

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp

# Local scratch
*.local
*~

# Local Wrangler state
.wrangler/

# Local database backups — never commit production exports
beta-backup-*.sql
